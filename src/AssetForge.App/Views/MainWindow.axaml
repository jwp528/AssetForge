<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AssetForge.App.ViewModels"
        x:Class="AssetForge.App.Views.MainWindow"
        Title="AssetForge" Width="1280" Height="800" MinWidth="980" MinHeight="640"
        Background="#111218">
  <Grid RowDefinitions="64,*,180,32">
    <Border Grid.Row="0" Background="#171920" BorderBrush="#2A2D37" BorderThickness="0,0,0,1" Padding="20,0">
      <Grid ColumnDefinitions="Auto,24,*,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="7" Background="#6C5CE7"><TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" /></Border>
          <TextBlock Text="AssetForge" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding ProjectName, StringFormat='Project: {0}'}" Foreground="#B8BBC6" VerticalAlignment="Center" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <TextBlock Text="LocalAI" Foreground="#B8BBC6" />
          <TextBlock Text="{Binding ConnectionGlyph}" Foreground="#6CDBA5" />
          <TextBlock Text="{Binding LocalAIStatus}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="280,*,340">
      <Border Classes="panel" BorderThickness="0,0,1,0" Padding="16">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="section" Text="PROJECT" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Open folder" Command="{Binding OpenProjectCommand}" />
          </Grid>
          <ComboBox Grid.Row="1" Margin="0,14,0,10" ItemsSource="{Binding AssetFilters}" SelectedItem="{Binding AssetFilter}" />
          <TreeView Grid.Row="2" ItemsSource="{Binding ProjectTree}" SelectedItem="{Binding SelectedNode}">
            <TreeView.DataTemplates>
              <TreeDataTemplate DataType="vm:ProjectTreeNode" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="•" Foreground="#6C5CE7" />
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.DataTemplates>
          </TreeView>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="panel" BorderThickness="0,0,1,0" Padding="20">
        <Grid RowDefinitions="Auto,*,Auto">
          <StackPanel>
            <TextBlock Classes="section" Text="PREVIEW" />
            <TextBlock Text="{Binding PreviewTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,9,0,2" />
            <TextBlock Text="{Binding PreviewDetails}" Foreground="#989CAA" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Row="1" Margin="0,18" Background="#0D0E13" CornerRadius="8" BorderBrush="#292C35" BorderThickness="1">
            <Grid>
              <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="18" IsVisible="{Binding HasImagePreview}" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding !HasImagePreview}">
                <TextBlock Text="◉" FontSize="38" Foreground="#555A69" HorizontalAlignment="Center" />
                <TextBlock Text="Audio preview" Foreground="#747887" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <Button Content="▶ Play" Command="{Binding PlayCommand}" />
            <Button Content="Ⅱ Pause" Command="{Binding PauseCommand}" />
            <Button Content="■ Stop" Command="{Binding StopCommand}" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="panel" BorderThickness="0" Padding="20">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <TextBlock Classes="section" Text="GENERATE" />
            <TextBlock Text="Asset type" Margin="0,8,0,0" />
            <ComboBox ItemsSource="{Binding GenerationTypes}" SelectedItem="{Binding GenerationType}" />
            <TextBlock Text="Prompt" Margin="0,8,0,0" />
            <TextBox Text="{Binding Prompt}" AcceptsReturn="True" MinHeight="96" PlaceholderText="Describe the sound you want…" TextWrapping="Wrap" />
            <TextBlock Text="Model" Margin="0,8,0,0" />
            <ComboBox ItemsSource="{Binding SoundModels}" SelectedItem="{Binding SelectedModel}" DisplayMemberBinding="{Binding Id}" PlaceholderText="No compatible model" />
            <Grid ColumnDefinitions="*,12,*" Margin="0,8,0,0">
              <StackPanel><TextBlock Text="Duration (seconds)" /><NumericUpDown Value="{Binding DurationSeconds}" Minimum="0.1" Maximum="300" Increment="0.5" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="Seed (optional)" /><NumericUpDown Value="{Binding Seed}" /></StackPanel>
            </Grid>
            <Button Classes="primary" Margin="0,10,0,0" Content="Generate sound" Command="{Binding GenerateCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <TextBlock Text="TTS and image generation are planned for the next milestone." Foreground="#747887" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2" Classes="panel" BorderThickness="0,1,0,0" Padding="18,14">
      <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
        <TextBlock Classes="section" Text="GENERATED RESULTS" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Preview" Command="{Binding PlayCommand}" />
          <Button Classes="primary" Content="Replace original" Command="{Binding ReplaceOriginalCommand}" />
        </StackPanel>
        <ListBox Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding GeneratedAssets}" SelectedItem="{Binding SelectedGeneratedAsset}" Background="Transparent" Margin="0,10,0,0">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="10" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate><DataTemplate><Border Width="190" Height="80" Padding="12" CornerRadius="6" Background="#232630"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Type}" Foreground="#989CAA" /><TextBlock Text="{Binding ModelId}" Foreground="#747887" FontSize="11" TextTrimming="CharacterEllipsis" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="#15171D" Padding="12,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#AEB1BC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="12" Foreground="#FF7B87" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Border>
  </Grid>
</Window>
