<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AssetForge.App.ViewModels"
        x:Class="AssetForge.App.Views.MainWindow"
        Title="AssetForge" Icon="/Assets/Icons/app-icon-64.png"
        Width="1440" Height="900" MinWidth="1040" MinHeight="680" Background="#101116">
  <Grid RowDefinitions="54,*,30">
    <!-- Command bar -->
    <Border Grid.Row="0" Background="#17181E" BorderBrush="#2A2C34" BorderThickness="0,0,0,1" Padding="16,0">
      <Grid ColumnDefinitions="Auto,24,*,Auto,16,Auto,12,Auto" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Image Width="30" Height="30" Source="/Assets/Icons/app-icon-64.png" />
          <TextBlock Text="AssetForge" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding ProjectName, StringFormat='Project  /  {0}'}" Foreground="#A6A9B5" VerticalAlignment="Center" />
        <Button Grid.Column="3" Content="↶  Undo" Command="{Binding UndoCommand}" />
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="{Binding ActivityStatus}" Foreground="#989CAA" />
        </StackPanel>
        <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="LocalAI" Foreground="#A6A9B5" /><TextBlock Text="{Binding ConnectionGlyph}" Foreground="#6CDBA5" /><TextBlock Text="{Binding LocalAIStatus}" FontWeight="SemiBold" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Resizable editor workspace -->
    <Grid Grid.Row="1" ColumnDefinitions="250,5,*,5,310">
      <!-- Project rail -->
      <Border Grid.Column="0" Classes="panel" BorderThickness="0,0,1,0" Padding="12">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="section" Text="PROJECT" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Open" Command="{Binding OpenProjectCommand}" Padding="11,6" />
          </Grid>
          <TextBox Grid.Row="1" Margin="0,12,0,8" Text="{Binding AssetSearch}" PlaceholderText="Search assets…" />
          <ComboBox Grid.Row="2" Margin="0,0,0,8" ItemsSource="{Binding AssetFilters}" SelectedItem="{Binding AssetFilter}" />
          <TreeView Grid.Row="3" ItemsSource="{Binding ProjectTree}" SelectedItem="{Binding SelectedNode}" Background="Transparent">
            <TreeView.DataTemplates>
              <TreeDataTemplate DataType="vm:ProjectTreeNode" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="•" Foreground="#7C6CF2" /><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></StackPanel>
              </TreeDataTemplate>
            </TreeView.DataTemplates>
          </TreeView>
        </Grid>
      </Border>
      <GridSplitter Grid.Column="1" Background="#24262E" ResizeDirection="Columns" />

      <!-- Canvas + activity + chat composer -->
      <Border Grid.Column="2" Classes="panel" BorderThickness="0" Padding="14">
        <Grid RowDefinitions="Auto,*,150,Auto">
          <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,10">
            <StackPanel>
              <TextBlock Text="{Binding CanvasTitle}" FontSize="19" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CanvasDetails}" Foreground="#8F93A3" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <Button Content="▶ Play" Command="{Binding PlayCommand}" /><Button Content="Ⅱ" Command="{Binding PauseCommand}" /><Button Content="■" Command="{Binding StopCommand}" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="1" Background="#0B0C10" BorderBrush="#292B34" BorderThickness="1" CornerRadius="7" Margin="0,0,0,10">
            <Grid>
              <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="20" IsVisible="{Binding HasImagePreview}" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding !HasImagePreview}">
                <Border Width="58" Height="58" CornerRadius="29" BorderBrush="#7061DC" BorderThickness="2"><TextBlock Text="◉" FontSize="25" Foreground="#8C7EED" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="Audio workspace" Foreground="#8F93A3" HorizontalAlignment="Center" />
                <TextBlock Text="Choose a revision to preview, then Apply when it is ready." Foreground="#5F6370" FontSize="12" />
              </StackPanel>
            </Grid>
          </Border>

          <!-- Persistent per-asset activity feed -->
          <Border Grid.Row="2" Background="#14151B" BorderBrush="#292B34" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,10">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Classes="section" Text="ACTIVITY" />
              <ListBox Grid.Row="1" ItemsSource="{Binding Conversation}" SelectedItem="{Binding SelectedConversationEntry}" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate><Grid ColumnDefinitions="72,*" Margin="0,3"><TextBlock Text="{Binding Role}" Foreground="#8C7EED" FontSize="11" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" /></Grid></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <!-- Chat-style composer -->
          <Border Grid.Row="3" Background="#1B1D24" BorderBrush="#393C48" BorderThickness="1" CornerRadius="9" Padding="12">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,12,180">
              <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding Prompt}" AcceptsReturn="True" MinHeight="68" MaxHeight="130" PlaceholderText="Describe what to generate or change…" TextWrapping="Wrap" />
              <StackPanel Grid.Row="0" Grid.Column="2" Spacing="6"><TextBlock Classes="section" Text="ASSET NAME" /><TextBox Text="{Binding AssetName}" PlaceholderText="shuffle" /><TextBlock Text="{Binding DestinationHint}" Foreground="#727686" FontSize="10" /></StackPanel>
              <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="Auto,10,220,10,150,10,150,*" Margin="0,10,0,0">
                <ComboBox ItemsSource="{Binding GenerationTypes}" SelectedItem="{Binding GenerationType}" MinWidth="130" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding SoundModels}" SelectedItem="{Binding SelectedModel}" DisplayMemberBinding="{Binding Id}" PlaceholderText="No compatible model" />
                <NumericUpDown Grid.Column="4" Value="{Binding DurationSeconds}" Minimum="0.1" Maximum="300" Increment="0.5" PlaceholderText="Duration" />
                <NumericUpDown Grid.Column="6" Value="{Binding Seed}" PlaceholderText="Seed" />
              </Grid>
              <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
                <Button Content="Retry" Command="{Binding RetryCommand}" /><Button Classes="primary" Content="Generate draft" Command="{Binding GenerateCommand}" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" Background="#24262E" ResizeDirection="Columns" />

      <!-- Revision/properties inspector -->
      <Border Grid.Column="4" Classes="panel" BorderThickness="1,0,0,0" Padding="14">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel><TextBlock Classes="section" Text="REVISIONS" /><TextBlock Text="Drafts stay private until Apply" Foreground="#737786" FontSize="11" Margin="0,4,0,0" /></StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Revisions.Count, StringFormat='{}{0} drafts'}" Foreground="#8F93A3" />
          </Grid>
          <ListBox Grid.Row="1" ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision}" Background="Transparent" Margin="0,12,0,10">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Background="#22242C" BorderBrush="#333641" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                  <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Label}" FontWeight="Bold" Foreground="#B7AEFF" /><TextBlock Grid.Column="1" Text="{Binding State}" Foreground="#7C8191" FontSize="11" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Prompt}" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Margin="0,5,0,3" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ModelId}" Foreground="#707585" FontSize="10" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Border Grid.Row="2" BorderBrush="#2C2F38" BorderThickness="0,1,0,0" Padding="0,10">
            <Grid ColumnDefinitions="*,8,*"><Button Content="Rename" Command="{Binding RenameCommand}" HorizontalAlignment="Stretch" /><Button Grid.Column="2" Content="Delete draft" Command="{Binding DeleteRevisionCommand}" HorizontalAlignment="Stretch" /></Grid>
          </Border>
          <StackPanel Grid.Row="3" Spacing="8" Margin="0,8,0,0">
            <Button Classes="primary" Content="{Binding PublishLabel}" Command="{Binding ApplyCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
            <Button Content="Delete published asset" Command="{Binding DeleteAssetCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Foreground="#FF858E" />
            <TextBlock Text="{Binding InlineError}" Foreground="#FF7B87" TextWrapping="Wrap" FontSize="11" IsVisible="{Binding InlineError}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#15161B" BorderBrush="#272932" BorderThickness="0,1,0,0" Padding="10,0">
      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Non-destructive workspace · revisions and undo persist in .assetforge" Foreground="#696D79" FontSize="11" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding InlineError}" Foreground="#FF7B87" FontSize="11" VerticalAlignment="Center" /></Grid>
    </Border>
  </Grid>
</Window>
